# Strapi CMS (optional — falls back to mock data if unset)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
# When Strapi is configured, failures propagate by default.
# Enable only for preview/demo environments that may serve bundled sample data.
# STRAPI_MOCK_FALLBACK=false

# Canonical public origin used by metadata, share links, sitemap, and Giscus.
NEXT_PUBLIC_SITE_URL=https://jurnal.dev

# Giscus Comments (optional — comments section hidden if unset)
# Get values from https://giscus.app after enabling GitHub Discussions
NEXT_PUBLIC_GISCUS_REPO=jurnaldev/jurnaldev
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Blog Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
